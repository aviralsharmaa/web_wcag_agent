{
  "name": "Kotak Cherry",
  "app_id": "KOTAKCHERRY",
  "start_url": "https://cherry.kotak.bank.in/",
  "domain": "cherry.kotak.bank.in",
  "flow_steps": [
    {
      "id": "landing",
      "description": "Landing page initial load",
      "scan_scope": "pre_login",
      "actions": [],
      "wait_after": 3000
    },
    {
      "id": "explore_tab",
      "description": "Explore tab",
      "scan_scope": "pre_login",
      "actions": [
        {"type": "click", "selector": "text=Explore"}
      ],
      "wait_after": 3000
    },
    {
      "id": "dashboard_tab",
      "description": "Dashboard tab",
      "scan_scope": "pre_login",
      "actions": [
        {"type": "click", "selector": "text=Dashboard"}
      ],
      "wait_after": 3000
    },
    {
      "id": "holdings_tab",
      "description": "Holdings tab",
      "scan_scope": "pre_login",
      "actions": [
        {"type": "click", "selector": "text=Holdings"}
      ],
      "wait_after": 3000
    },
    {
      "id": "sips_tab",
      "description": "SIPs and more tab",
      "scan_scope": "pre_login",
      "actions": [
        {"type": "click", "selector": "text=SIPs and more"}
