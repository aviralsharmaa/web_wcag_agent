    {
      "id": "nfos",
      "description": "NFOs collection",
      "scan_scope": "pre_login",
      "actions": [
        {"type": "click", "selector": "text=Explore"},
        {"type": "click", "selector": "text=NFOs"}
      ],
      "wait_after": 3000
    },
    {
      "id": "all_funds",
      "description": "All funds page",
      "scan_scope": "pre_login",
      "actions": [
        {"type": "click", "selector": "text=Explore"},
        {"type": "click", "selector": "text=All funds"}
      ],
      "wait_after": 3000
    },
    {
      "id": "all_amcs",
      "description": "All AMCs page",
      "scan_scope": "pre_login",
