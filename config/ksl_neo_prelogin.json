{
  "name": "Kotak Securities Website - Pre Login",
  "app_id": "KSLNEOPRELOGIN",
  "start_url": "https://www.kotakneo.com/",
  "domain": "kotakneo.com",
  "flow_steps": [
    {
      "id": "homepage",
      "description": "Scan the homepage",
      "scan_scope": "pre_login",
      "actions": [],
      "wait_after": 3000
    },
    {
      "id": "explore_pre_login",
      "description": "Explore all public pre-login pages",
      "scan_scope": "pre_login",
      "actions": [
        {
          "type": "explore",
          "description": "Explore all public pages — Products, Pricing, About, Blog, Support, FAQ, Features, Brokerage, Open Account, and any other pre-login pages. Scroll down each page, click tabs, sections, and interactive elements. Do NOT click Login or Sign In."
        }
      ]
    }
  ],
  "analysis": {
    "analyze_every_screen": true,
    "screenshot_each_step": true,
    "run_wcag_buckets": true,
    "explore_all_routes": true,
    "max_explore_depth": 400,
    "max_screens": 150,
    "unique_screen_dedup": true,
    "llm_failure_fallback": true,
    "stagnation_window": 30,
    "strict_flow_actions": false,
    "cannot_verify_policy": "pass_leaning",
    "cannot_verify_threshold": 31,
    "cannot_verify_enforcement": "both",
    "run_zoom_test": true,
    "run_text_spacing_test": true,
    "run_keyboard_test": true,
    "run_screen_reader_test": true
  }
}
